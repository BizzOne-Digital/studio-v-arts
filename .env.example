# --- Database (MongoDB Atlas) ---
# mongodb+srv://USER:PASSWORD@cluster.xxxx.mongodb.net/
MONGODB_URI=
# Database name (default studio_v)
MONGODB_DB=studio_v

# --- Auth ---
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# One-time token needed to create the FIRST admin at /admin/setup. Remove after setup.
ADMIN_SETUP_TOKEN=

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (booking emails to the customer and the studio) ---
# Option 1: SMTP, for example a Gmail account with an app password
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Option 2: Resend
RESEND_API_KEY=
# From address (defaults to SMTP_USER)
EMAIL_FROM=
# Where studio notifications go (Admin, Website settings can override this)
STUDIO_NOTIFY_EMAIL=
