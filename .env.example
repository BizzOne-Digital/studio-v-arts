# --- Database (MongoDB Atlas) ---
# mongodb+srv://USER:PASSWORD@cluster.xxxx.mongodb.net/
MONGODB_URI=
# Database name (default studio_v)
MONGODB_DB=studio_v

# --- Auth ---
# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# One-time token needed to create the FIRST admin at /admin/setup. Remove after setup.
ADMIN_SETUP_TOKEN=

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (optional; Resend). Without these, nothing is emailed and admin shows a warning ---
RESEND_API_KEY=
EMAIL_FROM=
# Where studio notifications go (falls back to the contact email in Website settings)
STUDIO_NOTIFY_EMAIL=
